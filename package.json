{
	"name": "circle-chase",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#convex/*": "./convex/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"e2e": "node scripts/run-e2e.mjs && node scripts/outbox-e2e.mjs && node scripts/export-e2e.mjs && node scripts/fullrun-e2e.mjs",
		"convex": "CONVEX_AGENT_MODE=anonymous CONVEX_LOCAL_BACKEND_STARTUP_TIMEOUT_SECS=240 convex dev",
		"dev:all": "(CONVEX_AGENT_MODE=anonymous CONVEX_LOCAL_BACKEND_STARTUP_TIMEOUT_SECS=240 convex dev &) && vite dev"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"convex-test": "^0.0.71",
		"playwright": "^1.56.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/unbounded": "^5.3.0",
		"convex": "^1.50.0",
		"convex-svelte": "^0.15.1"
	}
}
